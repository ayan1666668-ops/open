{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-infra.tsbuildinfo"
  },
  "include": [
    "../../src/infra/*.test.ts",
    "../../src/infra/*.test.tsx",
    "../../src/infra/command-analysis/**/*.test.ts",
    "../../src/infra/command-analysis/**/*.test.tsx",
    "../../src/infra/command-explainer/**/*.test.ts",
    "../../src/infra/command-explainer/**/*.test.tsx",
    "../../src/infra/format-time/**/*.test.ts",
    "../../src/infra/format-time/**/*.test.tsx",
    "../../src/infra/net/**/*.test.ts",
    "../../src/infra/net/**/*.test.tsx",
    "../../src/infra/outbound/deliver*.test.ts",
    "../../src/infra/outbound/deliver*.test.tsx",
    "../../src/infra/tls/**/*.test.ts",
    "../../src/infra/tls/**/*.test.tsx",
    "../../src/media/**/*.test.ts",
    "../../src/media/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/infra/sqlite-*.test.ts",
    "../../src/infra/update-*.test.ts",
    "../../src/infra/update-*.test.tsx",
    "../../src/infra/package-update-*.test.ts",
    "../../src/infra/package-update-*.test.tsx"
  ]
}
